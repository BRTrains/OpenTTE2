// Purchase-list order for OpenTTE2, maintained by hand (purchase_list.file).
//
// 1. NWR-numbered engines, by number (numeric numbers, then the `D` diesel numbers).
// 2. The engines without an NWR number, by power (lowest first).
// 3. Coaches, by name.
// 4. Wagons, by name.
//
// The block names the item symbols the build produced, so a new or renamed candidate has to
// be added here by hand. A unit typed `types: [TRAM, TRAIN]` appears in both blocks: the tram
// side is ordered by the same rule.
//
// Rebuilt from the build's own items by tools/generate_sortpurchase.py, which BRBuild runs
// before it reads this file (purchase_list.script in src/grf/GRF.yaml).
sort(FEAT_TRAINS, [
  // -- engines with an NWR number, by number --
  // Thomas the Tank Engine (NWR 1, 350 hp)
  thomas_default_blue_train,
  // Edward the Blue Engine (NWR 2, 700 hp)
  edward_default_blue_train,
  // Henry the Green Engine (NWR 3, 1500 hp)
  henry_oldp_green_train,
  henry_old_green_train_v2,
  henry_new_green_train,
  henry_news_green_train,
  // Gordon the Big Engine (NWR 4, 2700 hp)
  gordon_default_blue_train,
  // James the Red Engine (NWR 5, 1000 hp)
  james_default_red_train,
  // Percy the Small Engine (NWR 6, 200 hp)
  percy_default_green_train,
  // Toby the Tram Engine (NWR 7, 170 hp)
  toby_default_brown_train,
  // Duck the Great Western Engine (NWR 8, 300 hp)
  duck_default_gwr_green_train,
  // Donald and Douglas the Scottish twins (NWR 9, 1000 hp)
  dnd_default_red_train,
  // Oliver the Great Western Engine (NWR 11, 200 hp)
  oliver_default_green_train,
  // Emily the Emerald Engine (NWR 12, 500 hp)
  emily_default_green_train,
  // Nia the Kenyan Engine (NWR 18, 400 hp)
  nia_default_orange_train,
  // Rebecca the air-smoothed Engine (NWR 22, 2700 hp)
  rebecca_default_yellow_train,
  // Rosie the Dock Tank Engine (NWR 37, 350 hp)
  rosie_default_lavender_train,
  rosie_default_red_train,
  // Hiro the Japanese Engine (NWR 51, 2300 hp)
  hiro_default_black_train,
  // Salty the Dockyard Diesel (NWR 2991, 275 hp)
  salty_default_red_train,
  // Arthur the Big Tank Engine (NWR 41241, 600 hp)
  arthur_default_lms_red_train,
  // Daisy the Diesel Railcar (D1)
  daisy_default_green_train,
  // BoCo the Big Diesel (D2)
  boco_default_green_train,
  boco_default_green__rws__train,
  // Derek the Paxman Diesel (D5)
  derek_default_green_train,

  // -- engines with no NWR number, lowest power first --
  // Bill and Ben the Twin Engines (100 hp)
  bill_ben_default_yellow_train,
  // Mavis the Quarry Engine (154 hp)
  mavis_default_black_train,
  // Diesel (350 hp)
  diesel_default_black_train,
  // Molly the Yellow Engine (700 hp)
  molly_default_yellow_train,
  // Neville (900 hp)
  neville_default_black_train,
  // Murdoch the Mighty Engine (2000 hp)
  murdoch_default_orange_train,
  // Spencer the Silver Engine (2700 hp)
  spencer_default_silver_train,

  // -- coaches, by name --
  // 2 axle Branchline Coach
  branchlinecoach_default_orange_train,
  branchlinecoach_default_orange_brake_train,
  branchlinecoach_default_green_and_cream_train,
  branchlinecoach_default_green_and_cream_brake_train,
  branchlinecoach_default_red_train,
  branchlinecoach_default_red_brake_train,
  // Annie & Clarabel
  annie_clarabel_default_orange_train,
  // Express Coach
  coaches_default_red_and_white_train,
  coaches_default_green_and_white_train,
  coaches_default_orange_train,
  coaches_default_red_and_cream_train,
  coaches_default_green_and_cream_train,
  // Henrietta
  henrietta_default_wood_train,
  // Isabel the Autocoach
  isabel_default_cream_and_brown_train,

  // -- wagons, by name --
  // 2 axle Box Van
  van_default_brown_train,
  // 2 axle flatbed
  flatbed_default_grey_train,
  // 2 axle Plain tanker
  tanker_default_white_train,
  tanker_default_black_train,
  // 2 axle Plank Truck
  truck_default_grey_train,
  // 3 Plank Wagon
  smallccwagon_default_grey_train,
  // Brakevan
  brakevan_default_black_train,
  // Bruno the Sodor Lines Caboose
  bruno_default_red_train,
  // CCT/Utility Van
  utilityvan_default_wood_train,
  // Elsie
  elsie_default_wood_train,
  // L&BR bogie truck
  bogietruck_default_red_train,
  // L&BR Van
  lnbrvan_default_brown_train,
  // Long Flatbed
  longflatbed_default_grey_train,
  longflatbed_default_green_train,
  // S.C. Ruffey
  scruffey_default_grey_train,
  // Toad the Brakevan
  toad_default_grey_train
]);

// The tram side of the units typed for both features (Toby, Mavis).
sort(FEAT_ROADVEHS, [
  // -- engines with an NWR number, by number --
  // Toby the Tram Engine (NWR 7, 170 hp)
  toby_default_brown_tram,

  // -- engines with no NWR number, lowest power first --
  // Mavis the Quarry Engine (154 hp)
  mavis_default_black_tram,
  // Bertie the Bus (200 hp)
  bertie_default_red_road,
  // Terence the Tractor (200 hp)
  terence_default_orange_road
]);
