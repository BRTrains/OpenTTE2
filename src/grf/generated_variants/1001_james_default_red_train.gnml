switch (FEAT_TRAINS, SELF, switch_articulated_james_default_red_train, extra_callback_info1)
{
	1 : james_default_red_train;
	CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

spriteset(spriteset_james_default_red_train_purchase, "/Users/jon/Dev/BRBuild/WorkingData/OpenTTE2/purchase_james_James_0_James_22.png") {
	tmpl_purchase(0, 0)
}

spriteset(spriteset_james_default_red_train_0, "/Users/jon/Dev/OpenTTE2/src/vehicles/trains/James/James.png") {
	tmpl_train_6(0, 0)
}

spriteset(spriteset_james_default_red_train_1, "/Users/jon/Dev/OpenTTE2/src/vehicles/trains/James/James.png") {
	tmpl_train_4(0, 22)
}

switch (FEAT_TRAINS, SELF, sw_james_default_red_train, position_in_articulated_veh % 2)
{
	0 : spriteset_james_default_red_train_0;
	1 : spriteset_james_default_red_train_1;
}

switch (FEAT_TRAINS, SELF, sw_james_default_red_train_length, position_in_articulated_veh % 2)
{
	0 : 6;
	1 : 4;
}

item (FEAT_TRAINS, james_default_red_train, 1001) {
	property {
		air_drag_coefficient: 0.07648;
		badges: ["Power/Steam", "operator/NWR", "whyte/0-6-0", "NWR/5"];
		cargo_capacity: 1;
		climates_available: ALL_CLIMATES;
		engine_class: ENGINE_CLASS_STEAM;
		introduction_date: date(1, 1, 1);
		model_life: VEHICLE_NEVER_EXPIRES;
		name: string(str_james_default_red_train_name);
		power: 1000 hp;
		speed: 65 mph;
		tractive_effort_coefficient: 0.26465;
		vehicle_life: 30;
		weight: 47 ton;
	}
	graphics {
		articulated_part: switch_articulated_james_default_red_train;
		cargo_capacity: 0 * param_passenger_multiplier;
		cost_factor: 76;
		running_cost_factor: 76;
		additional_text: string(str_james_default_red_train_additional_text);
		default: sw_james_default_red_train;
		length: sw_james_default_red_train_length;
		purchase: spriteset_james_default_red_train_purchase;
	}
}

